# Dependencies, installed by npm
node_modules/

# What a running jukecord writes: the database, the media cache and the logs
data/

# Copies of the database that ./jukecord backup takes out of the container: people's history, never committed
/backups/

# Settings with secrets in them; .env.example is the one that is committed
.env

# The split's certificate authorities, the host's own; only the folder's README is committed
/deploy/split/ca/*
!/deploy/split/ca/README.md

# Coverage reports from the test runner
coverage/

# Local plans and scratch work, never committed
/_work/

# The built panel (npm run build)
panel/dist/
