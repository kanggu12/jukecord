# Starts jukecord's Compose project when the machine starts, and stops it cleanly when it shuts down.
#
# Optional: Docker's restart policy (unless-stopped) already brings jukecord back after a crash or a Docker restart.
# This unit is for machines where Docker itself is not started at boot, or where shutting down must wait for
# jukecord to save where every server was. docs/INSTALL.md has the commands to install it.
[Unit]
Description=jukecord (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The folder of the jukecord checkout (where compose.yaml and .env are); the install command fills it in.
WorkingDirectory=/opt/jukecord
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
# The first start may build the image.
TimeoutStartSec=600
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
