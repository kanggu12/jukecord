# Starts jukecord's Compose project with the machine and stops it at shutdown. docs/INSTALL.md has the commands.
[Unit]
Description=jukecord (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The folder of the jukecord checkout (where compose.yaml and .env are); the install command fills it in.
WorkingDirectory=/opt/jukecord
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
# The first start may build the image.
TimeoutStartSec=600
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
