# The split's own settings for deploy/split/compose.yaml: copy to deploy/split/.env and fill in the two secrets.
# jukecord's other settings (Discord, the public address, the limits) stay in the checkout's .env, as for one process.

# The database's password (openssl rand -hex 16 makes one). Set once: the database keeps the first one it was given.
JUKECORD_DB_PASSWORD=

# The secret the core and its edges share, 32 characters or more (openssl rand -hex 32 makes one).
JUKECORD_INTERNAL_SECRET=

# Where the front is published: the port, and on which addresses (127.0.0.1: this machine only; 0.0.0.0: the network).
JUKECORD_PORT=8795
JUKECORD_BIND=127.0.0.1

# A released image instead of a local build (ghcr.io/<owner>/jukecord:<version>).
JUKECORD_IMAGE=

# The host's time zone ("today" in the statistics, the time of day of scheduled backups); UTC when empty.
TZ=
