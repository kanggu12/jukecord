# jukecord's settings: copy this file to .env, beside the jukecord program, and fill in what you use. Every setting
# is optional; with none, jukecord runs browser-only (open it with: jukecord open). A setting in the environment wins
# over this file.

# The Discord bot (https://discord.com/developers/applications -> your application -> Bot -> Reset Token).
# Without it jukecord plays in browsers only.
JUKECORD_DISCORD_TOKEN=

# Logging in to the panel with Discord: the application's ID (General Information) and its OAuth2 client secret.
# Add <JUKECORD_PUBLIC_URL>/auth/callback to the application's OAuth2 redirects. Without these, the host logs in
# with: jukecord open.
JUKECORD_DISCORD_CLIENT_ID=
JUKECORD_DISCORD_CLIENT_SECRET=

# Where jukecord keeps its data: empty for a SQLite file in the data folder (nothing to set up), or a database server:
#   postgres://user:password@host:5432/jukecord   PostgreSQL 14 or newer
#   mysql://user:password@host:3306/jukecord      MySQL 8.0 or newer, or MariaDB 10.11 or newer (mariadb:// too)
# Add ?sslmode=verify-full for TLS (or require, verify-ca). Write @ : / ? # in a password as %40 %3A %2F %3F %23.
# Moving the data from one to another: jukecord db copy <from> <to>.
JUKECORD_DATABASE_URL=
# The most connections jukecord opens to a database server (empty: 10).
JUKECORD_DATABASE_POOL=

# Certificate authorities of your own (a PEM file of one or more), which every TLS connection jukecord makes trusts
# besides the ones Node.js ships with: a database, a Redis or Valkey (rediss://), an identity provider, a directory.
# The panel's Settings page takes them pasted or from a file too (so does `./jukecord settings ca import <file>`).
JUKECORD_CA_FILE=

# The address people open the panel at, when it is not this machine (for login and the links the bot posts).
# Example: https://music.example.com
JUKECORD_PUBLIC_URL=

# The port the panel listens on, and on which address (127.0.0.1: this machine only; 0.0.0.0: the network too); empty:
# 8795 on 127.0.0.1.
JUKECORD_PORT=
JUKECORD_HOST=

# Where the database, the cache, the logs and the backups are: empty for the system's place for a program's data
# (~/.local/share/jukecord on Linux, ~/Library/Application Support/jukecord on macOS, %LOCALAPPDATA%\jukecord on
# Windows), or a full path.
JUKECORD_DATA_DIR=

# Behind a reverse proxy: how many proxies stand in front (1 for one Caddy or nginx), or their addresses.
JUKECORD_TRUST_PROXY=

# Fetch from addresses on private networks too (a media server on the local network): true turns it on.
JUKECORD_ALLOW_PRIVATE_ADDRESSES=

# Limits: the media cache, the longest track, the longest queue, how long the bot stays alone in a voice channel
# (empty: 2GiB, 3h, 1000 and 5m).
JUKECORD_CACHE_MAX=
JUKECORD_TRACK_MAX=
JUKECORD_QUEUE_MAX=
JUKECORD_VOICE_IDLE=
# How long a server nobody hears anywhere (the bot out of voice, no browser playing along) plays on before it pauses;
# 0 plays on (empty: 2m).
JUKECORD_REST_AFTER=

# A backup of the database every day at this time of day (04:30, in this machine's time zone), or off; and how many
# backups stay in the data's backups folder (empty: off, and 7).
JUKECORD_BACKUP_AT=
JUKECORD_BACKUP_KEEP=

# A cookies file for YouTube's "sign in to confirm you're not a bot": its full path (docs/TROUBLESHOOTING.md says how
# to make one).
JUKECORD_YTDLP_COOKIES=

# debug, info, warn or error (empty: info).
JUKECORD_LOG_LEVEL=
# How the console's lines are written: text (readable, when empty), or json (one object per line, for a log shipper
# such as Loki, Elasticsearch or CloudWatch). The log files in the data folder are JSON either way.
JUKECORD_LOG_FORMAT=

# A token that lets a Prometheus outside this machine's network, or behind a proxy, read /metrics: it sends
# Authorization: Bearer <token>. Without it only a scraper on this machine or its network may. At least 16
# characters; openssl rand -hex 32 makes one.
JUKECORD_METRICS_TOKEN=

# Lyrics for the track playing, from LRCLIB (lrclib.net: it is sent the song's title, artist, album and length):
# off turns them off (empty: on).
JUKECORD_LYRICS=

# Links of other music services jukecord reads and finds on YouTube: deezer, spotify, apple-music (none: none).
JUKECORD_LINK_SERVICES=
# Your own Spotify app (https://developer.spotify.com/dashboard), for Spotify albums and playlists; single Spotify
# tracks are read without it.
JUKECORD_SPOTIFY_CLIENT_ID=
JUKECORD_SPOTIFY_CLIENT_SECRET=

# Logging in through your own identity provider (OpenID Connect: Keycloak, Authentik, Entra ID, Okta, Google ...).
# Register jukecord as a client with the redirect <JUKECORD_PUBLIC_URL>/auth/sso/callback (and <...>/login after
# logging out). Who may log in, and as what, comes from the groups or roles in the claim named below: admin may do
# what the host may, control changes the music in every server, read looks and listens (* lets in everyone).
JUKECORD_OIDC_ISSUER=
JUKECORD_OIDC_CLIENT_ID=
JUKECORD_OIDC_CLIENT_SECRET=
# The scopes asked for (empty: openid profile), and where the groups are: a claim's name (empty: groups) or a dotted
# path such as realm_access.roles (Keycloak's realm roles).
JUKECORD_OIDC_SCOPES=
JUKECORD_OIDC_GROUPS_CLAIM=
JUKECORD_OIDC_ADMIN_GROUPS=
JUKECORD_OIDC_CONTROL_GROUPS=
JUKECORD_OIDC_READ_GROUPS=
# The words on the login key (empty: "Log in with SSO"), and a claim with a Discord user ID, to log in as that user.
JUKECORD_OIDC_LABEL=
JUKECORD_OIDC_DISCORD_CLAIM=

# Logging in with a directory account (LDAP: OpenLDAP, FreeIPA; Active Directory). The service account finds the
# person under the base DN with the user filter (empty: (uid={username}); Active Directory's is
# (sAMAccountName={username})), then the directory checks their password. ldaps:// is encrypted; ldap:// with
# STARTTLS=yes upgrades; CA_FILE names a private CA's certificates. Groups come from memberOf, or from a search with
# the group filter ((member={dn}), say), or with NESTED_GROUPS=yes from Active Directory's nested groups; list them by
# DN or by name, separated by semicolons. The timeout is per request (empty: 10s).
JUKECORD_LDAP_URL=
JUKECORD_LDAP_STARTTLS=
JUKECORD_LDAP_CA_FILE=
JUKECORD_LDAP_BIND_DN=
JUKECORD_LDAP_BIND_PASSWORD=
JUKECORD_LDAP_BASE_DN=
JUKECORD_LDAP_USER_FILTER=
JUKECORD_LDAP_GROUP_FILTER=
JUKECORD_LDAP_GROUP_BASE_DN=
JUKECORD_LDAP_NESTED_GROUPS=
JUKECORD_LDAP_ADMIN_GROUPS=
JUKECORD_LDAP_CONTROL_GROUPS=
JUKECORD_LDAP_READ_GROUPS=
JUKECORD_LDAP_TIMEOUT=
# The words on the directory form's key (empty: the panel's own).
JUKECORD_LDAP_LABEL=

# Split into services (one core, any number of edges): docs/KUBERNETES.md and deploy/split/compose.yaml, which sets
# these for each service. One process (the default) needs none of them.
# all (one process), core (Discord, the players, the media: exactly one) or edge (the panel and the API: any number).
JUKECORD_ROLE=
# The Redis or Valkey server the services talk through (redis://, rediss:// for TLS); a password goes in the address.
JUKECORD_BUS_URL=
# The shared cache (the rates, the searches' results): memory, or a Redis or Valkey address; the services use the
# bus's server unless this says otherwise.
JUKECORD_CACHE_URL=
# What everything jukecord keeps on that server goes under, so several jukecords can share one (default jukecord).
JUKECORD_KEY_PREFIX=
# The secret the core and its edges share (32 characters or more: openssl rand -hex 32), the core's port for its edges,
# and where an edge finds that port.
JUKECORD_INTERNAL_SECRET=
JUKECORD_INTERNAL_PORT=8796
JUKECORD_CORE_URL=
