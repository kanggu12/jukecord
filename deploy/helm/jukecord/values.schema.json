{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "jukecord Helm values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "discord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "token": { "type": "string" },
        "clientId": { "type": "string", "pattern": "^(|\\d{17,20})$" },
        "clientSecret": { "type": "string" }
      }
    },
    "publicUrl": { "type": "string", "pattern": "^(|https?://[^\\s/]+(/.*)?)$" },
    "env": {
      "type": "object",
      "description": "JUKECORD_* settings passed as they are, as strings (quote numbers and IDs); the port, the listening address, the data directory and the secret files belong to the chart, and the token and the OAuth secret go in discord",
      "propertyNames": { "pattern": "^JUKECORD_[A-Z_]+$" },
      "additionalProperties": { "type": ["string", "boolean"] }
    },
    "extraEnv": {
      "type": "array",
      "description": "More variables as Kubernetes EnvVar objects (NODE_OPTIONS, TZ, HTTPS_PROXY, or a value from a ConfigMap); the names refused in env are refused here too",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "value": { "type": "string" },
          "valueFrom": { "type": "object" }
        },
        "not": { "required": ["value", "valueFrom"] }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "host": {
          "type": "string",
          "description": "A host name, without a scheme or a path; a leading *. for a wildcard",
          "pattern": "^(|(\\*\\.)?[A-Za-z0-9]([-A-Za-z0-9]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([-A-Za-z0-9]*[A-Za-z0-9])?)*)$"
        },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "size": {
          "type": "string",
          "description": "A Kubernetes quantity: 1Gi, 500Mi, 2G",
          "pattern": "^([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(Ki|Mi|Gi|Ti|Pi|Ei|m|k|M|G|T|P|E|[eE][+-]?[0-9]+)?$"
        },
        "accessModes": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": {
          "type": "array",
          "description": "NetworkPolicy peers (podSelector, namespaceSelector, ipBlock) that may reach the panel's port; empty: anyone",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "podSelector": { "type": "object" },
              "namespaceSelector": { "type": "object" },
              "ipBlock": { "type": "object" }
            }
          }
        },
        "privateRanges": {
          "type": "array",
          "description": "Address ranges with their prefix length, IPv4 or IPv6",
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}|[0-9A-Fa-f:]*:[0-9A-Fa-f:]*/[0-9]{1,3})$"
          }
        }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": {
      "type": "object",
      "description": "Labels in Kubernetes' form: a name of up to 63 letters, digits, - _ and . (with an optional prefix/), a value the same or empty",
      "propertyNames": {
        "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
      },
      "additionalProperties": { "type": "string", "pattern": "^(([A-Za-z0-9][-A-Za-z0-9_.]{0,61})?[A-Za-z0-9])?$" }
    },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "global": {
      "type": "object",
      "description": "What a parent chart gives every chart it depends on; jukecord reads none of it"
    }
  }
}
