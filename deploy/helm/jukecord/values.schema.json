{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "jukecord Helm values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "mode": {
      "enum": ["single", "split"],
      "description": "single: one pod is all of jukecord; split: one core and edges, over a shared database and a Redis or Valkey bus"
    },
    "bus": {
      "type": "object",
      "description": "The Redis or Valkey server of split mode: its address, or a Secret holding it under url",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^(|(redis|rediss|valkey|valkeys)://.+)$" },
        "existingSecret": { "type": "string" }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "core": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "resources": { "type": "object" } }
        },
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "replicas": { "type": "integer", "minimum": 1 },
            "resources": { "type": "object" },
            "autoscaling": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "minReplicas": { "type": "integer", "minimum": 1 },
                "maxReplicas": { "type": "integer", "minimum": 1 },
                "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            }
          }
        }
      }
    },
    "discord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "token": { "type": "string" },
        "clientId": { "type": "string", "pattern": "^(|\\d{17,20})$" },
        "clientSecret": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "The database's address as JUKECORD_DATABASE_URL takes it; empty for the SQLite file in the data volume",
          "pattern": "^(|sqlite:.*|(postgres|postgresql|mysql|mariadb)://.+)$"
        },
        "existingSecret": { "type": "string", "description": "A Secret holding the address under the key url" }
      }
    },
    "publicUrl": { "type": "string", "pattern": "^(|https?://[^\\s/]+(/.*)?)$" },
    "ca": {
      "type": "object",
      "description": "Certificate authorities (PEM) every TLS connection trusts besides Node's own: a Secret or a ConfigMap, and its key, on every pod",
      "additionalProperties": false,
      "properties": {
        "secret": { "type": "string" },
        "configMap": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "auth": {
      "type": "object",
      "description": "Logging in through an identity provider (OIDC) and with directory accounts (LDAP), on the pods that serve browsers",
      "additionalProperties": false,
      "properties": {
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^(|https?://[^\\s?#]+)$",
              "description": "The issuer's address; empty: off"
            },
            "clientId": { "type": "string" },
            "clientSecret": { "type": "string" },
            "existingSecret": {
              "type": "string",
              "description": "A Secret holding the client's secret under the key oidcClientSecret"
            },
            "scopes": { "type": "array", "items": { "type": "string", "pattern": "^\\S+$" } },
            "groupsClaim": { "type": "string", "pattern": "^(|[^\\s.]+(\\.[^\\s.]+)*)$" },
            "adminGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "controlGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "readGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "label": { "type": "string", "maxLength": 40 },
            "discordClaim": { "type": "string", "pattern": "^(|[^\\s.]+(\\.[^\\s.]+)*)$" }
          }
        },
        "ldap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(|ldaps?://[^\\s/]+/?)$",
              "description": "ldap://host or ldaps://host; empty: off"
            },
            "startTls": { "type": "boolean" },
            "bindDn": { "type": "string" },
            "bindPassword": { "type": "string" },
            "existingSecret": {
              "type": "string",
              "description": "A Secret holding the bind password under the key ldapBindPassword"
            },
            "baseDn": { "type": "string" },
            "userFilter": { "type": "string" },
            "groupFilter": { "type": "string" },
            "groupBaseDn": { "type": "string" },
            "nestedGroups": { "type": "boolean" },
            "adminGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "controlGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "readGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "timeout": { "type": "string", "pattern": "^(|\\s*\\d+(\\.\\d+)?\\s*[A-Za-z]*\\s*)$" },
            "label": { "type": "string", "maxLength": 40 }
          }
        },
        "egressTo": {
          "type": "array",
          "description": "NetworkPolicy egress rules (to, ports) to the provider and the directory, for the pods that log people in",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "to": { "type": "array", "items": { "type": "object" } },
              "ports": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "description": "The token a scraper shows for /metrics (Authorization: Bearer): empty, or one word of at least 16 characters",
          "pattern": "^(|\\S{16,})$"
        },
        "existingSecret": { "type": "string" },
        "podAnnotations": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "force": { "type": "boolean" },
            "labels": {
              "type": "object",
              "propertyNames": {
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^(([A-Za-z0-9][-A-Za-z0-9_.]{0,61})?[A-Za-z0-9])?$"
              }
            },
            "interval": {
              "type": "string",
              "description": "A Prometheus duration: 30s, 1m, 1m30s",
              "pattern": "^([0-9]+(ms|s|m|h))+$"
            },
            "scrapeTimeout": { "type": "string", "pattern": "^([0-9]+(ms|s|m|h))+$" }
          }
        }
      }
    },
    "env": {
      "type": "object",
      "description": "JUKECORD_* settings passed as they are, as strings (quote numbers and IDs); the port, the listening address, the data directory and the secret files belong to the chart, and the token and the OAuth secret go in discord",
      "propertyNames": { "pattern": "^JUKECORD_[A-Z_]+$" },
      "additionalProperties": { "type": ["string", "boolean"] }
    },
    "extraEnv": {
      "type": "array",
      "description": "More variables as Kubernetes EnvVar objects (NODE_OPTIONS, TZ, HTTPS_PROXY, or a value from a ConfigMap); the names refused in env are refused here too",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "value": { "type": "string" },
          "valueFrom": { "type": "object" }
        },
        "not": { "required": ["value", "valueFrom"] }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "host": {
          "type": "string",
          "description": "A host name, without a scheme or a path; a leading *. for a wildcard",
          "pattern": "^(|(\\*\\.)?[A-Za-z0-9]([-A-Za-z0-9]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([-A-Za-z0-9]*[A-Za-z0-9])?)*)$"
        },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "size": {
          "type": "string",
          "description": "A Kubernetes quantity: 1Gi, 500Mi, 2G",
          "pattern": "^([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(Ki|Mi|Gi|Ti|Pi|Ei|m|k|M|G|T|P|E|[eE][+-]?[0-9]+)?$"
        },
        "accessModes": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": {
          "type": "array",
          "description": "NetworkPolicy peers (podSelector, namespaceSelector, ipBlock) that may reach the panel's port; empty: anyone",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "podSelector": { "type": "object" },
              "namespaceSelector": { "type": "object" },
              "ipBlock": { "type": "object" }
            }
          }
        },
        "egressTo": {
          "type": "array",
          "description": "NetworkPolicy egress rules (to, ports) to the database (and the bus in split mode); empty with a database set: the release's namespace on 5432 and 3306, and 6379 in split mode",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "to": { "type": "array", "items": { "type": "object" } },
              "ports": { "type": "array", "items": { "type": "object" } }
            }
          }
        },
        "privateRanges": {
          "type": "array",
          "description": "Address ranges with their prefix length, IPv4 or IPv6",
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}|[0-9A-Fa-f:]*:[0-9A-Fa-f:]*/[0-9]{1,3})$"
          }
        }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": {
      "type": "object",
      "description": "Labels in Kubernetes' form: a name of up to 63 letters, digits, - _ and . (with an optional prefix/), a value the same or empty",
      "propertyNames": {
        "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
      },
      "additionalProperties": { "type": "string", "pattern": "^(([A-Za-z0-9][-A-Za-z0-9_.]{0,61})?[A-Za-z0-9])?$" }
    },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "global": {
      "type": "object",
      "description": "What a parent chart gives every chart it depends on; jukecord reads none of it"
    }
  }
}
