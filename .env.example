# jukecord's settings for Docker Compose: copy to .env (./jukecord up does it for you) and fill in what you use.
# Every setting is optional; with none, jukecord runs browser-only (open it with ./jukecord open).

# The Discord bot (https://discord.com/developers/applications -> your application -> Bot -> Reset Token).
# Without it jukecord plays in browsers only.
JUKECORD_DISCORD_TOKEN=

# Logging in to the panel with Discord: the application's ID (General Information) and its OAuth2 client secret.
# Add <JUKECORD_PUBLIC_URL>/auth/callback to the application's OAuth2 redirects. Without these, the host logs in
# with ./jukecord open.
JUKECORD_DISCORD_CLIENT_ID=
JUKECORD_DISCORD_CLIENT_SECRET=

# The address people open the panel at, when it is not this machine (for login and the links the bot posts).
# Example: https://music.example.com
JUKECORD_PUBLIC_URL=

# The port the panel is published on, and on which addresses (127.0.0.1: this machine only; 0.0.0.0: the network).
JUKECORD_PORT=8795
JUKECORD_BIND=127.0.0.1

# Behind a reverse proxy: how many proxies stand in front (1 for one Caddy or nginx), or their addresses.
JUKECORD_TRUST_PROXY=

# Fetch from addresses on private networks too (a media server on the local network): true turns it on.
JUKECORD_ALLOW_PRIVATE_ADDRESSES=

# Limits: the media cache, the longest track, the longest queue, how long the bot stays alone in a voice channel.
JUKECORD_CACHE_MAX=2GiB
JUKECORD_TRACK_MAX=3h
JUKECORD_QUEUE_MAX=1000
JUKECORD_VOICE_IDLE=5m
# How long a server nobody hears anywhere (the bot out of voice, no browser playing along) plays on before it pauses;
# 0 plays on.
JUKECORD_REST_AFTER=2m

# A backup of the database every day at this time of day (04:30, in this machine's time zone), or off; and how many
# backups stay in the volume's backups folder.
JUKECORD_BACKUP_AT=off
JUKECORD_BACKUP_KEEP=7

# A cookies file for YouTube's "sign in to confirm you're not a bot": a path inside the container, for a file copied
# into the volume (docs/TROUBLESHOOTING.md has the commands).
JUKECORD_YTDLP_COOKIES=

# debug, info, warn or error.
JUKECORD_LOG_LEVEL=info

# Lyrics for the track playing, from LRCLIB (lrclib.net: it is sent the song's title, artist, album and length):
# off turns them off.
JUKECORD_LYRICS=on

# Links of other music services jukecord reads and finds on YouTube: deezer, spotify, apple-music (none: none).
JUKECORD_LINK_SERVICES=
# Your own Spotify app (https://developer.spotify.com/dashboard), for Spotify albums and playlists; single Spotify
# tracks are read without it.
JUKECORD_SPOTIFY_CLIENT_ID=
JUKECORD_SPOTIFY_CLIENT_SECRET=
