#!/usr/bin/env bash
# The front door: runs jukecord with Docker Compose and passes everything else to the jukecord command inside it.
#
#   ./jukecord up          start (builds the image the first time; makes .env from .env.example)
#   ./jukecord open        a one-time login link for this browser (opens it when it can)
#   ./jukecord status      is it running, which version, is Discord connected (./jukecord version: the same)
#   ./jukecord logs [-f]   jukecord's log (-f follows the console lines live)
#   ./jukecord doctor      check every part jukecord needs, here and inside the container
#   ./jukecord update      a newer image (pulled, or rebuilt from this checkout), then restart
#   ./jukecord restart     stop and start again (a changed .env needs ./jukecord up instead)
#   ./jukecord backup      a copy of the database, into ./backups
#   ./jukecord restore F   put a backup back (the current database is kept beside it first)
#   ./jukecord down        stop (the data stays in the volume)
#   ./jukecord <command>   anything else goes to the jukecord command: np, add, skip, queue, token create ...
#
# Exit codes: those of the command run; 1 when Docker or the settings are not usable; 2 for a typing mistake here.
set -euo pipefail

# Where the command was typed, for file names given relative to it (restore), before moving to the checkout.
caller=$PWD
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$here"
service=jukecord

# Says something on stderr, prefixed so it is clear where it came from.
say() { printf 'jukecord: %s\n' "$*" >&2; }

# docker compose, after checking it exists (the error otherwise is "compose is not a docker command").
compose() {
  if ! docker compose version >/dev/null 2>&1; then
    say "Docker Compose is needed (https://docs.docker.com/compose/install/)"
    exit 1
  fi
  docker compose "$@"
}

# Docker answering and Compose able to read compose.yaml with this .env, checked before anything else and with the
# tools' own words when not: otherwise a stopped Docker reads as "not running", and a line in .env that Compose cannot
# read ends a command with no message at all.
preflight() {
  local out
  if ! command -v docker >/dev/null 2>&1; then
    say "Docker is needed (https://docs.docker.com/get-docker/)"
    exit 1
  fi
  # Its error alone (what it prints on stdout then is an empty line).
  if ! out=$(docker info --format '{{.ServerVersion}}' 2>&1 >/dev/null); then
    printf '%s\n' "$out" >&2
    say "Docker is not answering; start it (or check DOCKER_HOST and the current docker context) and try again"
    exit 1
  fi
  if ! out=$(compose config -q 2>&1); then
    printf '%s\n' "$out" >&2
    say "Compose cannot read compose.yaml with these settings; the line above says which (usually in .env)"
    exit 1
  fi
}

# This machine's time zone, so times the jukecord command prints and "today" in the statistics are local.
timezone() {
  local link
  if [ -n "${TZ:-}" ]; then printf '%s' "$TZ"
  elif command -v timedatectl >/dev/null 2>&1 && timedatectl show -p Timezone --value 2>/dev/null | grep -q .; then
    timedatectl show -p Timezone --value
  elif [ -f /etc/timezone ]; then cat /etc/timezone
  # macOS (and Linux without the two above): /etc/localtime links to the zone's file, .../zoneinfo/Europe/Berlin.
  elif link=$(readlink /etc/localtime 2>/dev/null) && [ "${link#*zoneinfo/}" != "$link" ]; then
    printf '%s' "${link#*zoneinfo/}"
  else printf 'UTC'
  fi
}

# Whether the container is running.
running() {
  [ -n "$(compose ps --status running -q "$service" 2>/dev/null)" ]
}

# Runs the jukecord command inside the running container; it finds the host token there, so no login is needed.
inside() {
  if ! running; then
    say "jukecord is not running here (./jukecord up)"
    exit 1
  fi
  local tty=()
  # A terminal when there is one (colours, Ctrl+C); none for scripts and pipes.
  if [ -t 0 ] && [ -t 1 ]; then tty=(-it); else tty=(-T); fi
  compose exec "${tty[@]}" -e "TZ=$(timezone)" "$service" jukecord "$@"
}

# A setting from .env as Compose reads it: the last line that sets it, without quotes around the value, and without
# the comment after it (a space and #) when the value has no quotes.
setting() {
  local value
  value=$(sed -n "s/^$1=//p" .env 2>/dev/null | tail -n 1)
  case "$value" in
    \"* | \'*) printf '%s\n' "$value" | sed -e 's/^"\(.*\)"[[:space:]]*\(#.*\)\{0,1\}$/\1/' -e "s/^'\(.*\)'[[:space:]]*\(#.*\)\{0,1\}\$/\\1/" ;;
    *) printf '%s\n' "$value" | sed -e 's/[[:space:]]\{1,\}#.*$//' -e 's/[[:space:]]*$//' ;;
  esac
}

# The image Compose runs: jukecord:local, built from this checkout, unless JUKECORD_IMAGE names a released one.
image_name() {
  compose config --images | head -n 1
}

# Whether that image is the one built from this checkout (jukecord:local), rather than one to pull.
built_here() {
  case "$1" in *jukecord:local) return 0 ;; *) return 1 ;; esac
}

# The address the panel is reached at from this machine: the public one when set, else where Compose really published
# the port (which also follows JUKECORD_PORT and JUKECORD_BIND from the shell, not only from .env).
panel_url() {
  local url published host port
  url=$(setting JUKECORD_PUBLIC_URL)
  if [ -n "$url" ]; then
    printf '%s' "$url"
    return
  fi
  published=$(compose port "$service" 8795 2>/dev/null | tail -n 1)
  host=${published%:*}
  port=${published##*:}
  # Published on every address (0.0.0.0 or ::) or on this machine only: localhost, the name the documents use.
  case "$host" in '' | 0.0.0.0 | '[::]' | '::' | 127.0.0.1) host=localhost ;; esac
  printf 'http://%s:%s' "$host" "${port:-${JUKECORD_PORT:-$(setting JUKECORD_PORT)}}"
}

# Opens an address in a browser when this is someone's desktop; prints it either way.
open_url() {
  printf '%s\n' "$1"
  [ -t 1 ] || return 0
  if command -v wslview >/dev/null 2>&1; then wslview "$1" >/dev/null 2>&1 || true
  elif grep -qi microsoft /proc/version 2>/dev/null && command -v cmd.exe >/dev/null 2>&1; then
    # WSL without wslu: Windows opens the default browser.
    cmd.exe /c start "" "$1" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1 || true
  elif command -v open >/dev/null 2>&1; then open "$1" >/dev/null 2>&1 || true
  fi
}

# Starts jukecord again at the end of a restore, whatever happened before; a failure shows Compose's own words and
# makes the whole command fail.
start_again() {
  local out
  if ! out=$(compose up -d "$service" 2>&1); then
    printf '%s\n' "$out" >&2
    say "jukecord did not start again"
    exit 1
  fi
  wait_ready || exit 1
}

# Waits until the panel answers, up to a minute.
wait_ready() {
  local tries=60
  while [ "$tries" -gt 0 ]; do
    if compose exec -T "$service" node -e "fetch('http://127.0.0.1:8795/readyz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    tries=$((tries - 1))
  done
  say "jukecord did not answer within a minute; its console says why: ./jukecord logs -f"
  return 1
}

# The time zone the container runs in (compose.yaml passes TZ on): the shell's, else TZ in .env, else this machine's,
# so "today" in the statistics and the time of day of scheduled backups are the host's rather than UTC.
if [ -z "${TZ:-}" ]; then TZ=$(setting TZ); fi
TZ=${TZ:-$(timezone)}
export TZ

command=${1:-help}
# Every command but help and doctor needs Docker and readable settings; doctor reports on both instead of stopping.
case "$command" in
  help | -h | --help | doctor) ;;
  *) preflight ;;
esac
case "$command" in
  up)
    # Settings start from the example, readable by this user only (the bot's token goes in there).
    if [ ! -f .env ]; then
      cp .env.example .env
      chmod 600 .env
      say "made .env from .env.example; put the bot's token in it to use Discord (browser-only until then)"
    fi
    # The image of this checkout is built before the first start: Compose would otherwise try to pull jukecord:local
    # from Docker Hub first and print the refusal, which reads like a failure.
    image=$(image_name)
    if built_here "$image" && ! docker image inspect "$image" >/dev/null 2>&1; then
      say "building the image first (FFmpeg is compiled for audio: a few minutes, longer on a small machine)"
      compose build
    fi
    compose up -d "${@:2}"
    wait_ready
    printf 'jukecord is up: %s\n' "$(panel_url)"
    printf 'Log in with: ./jukecord open\n'
    ;;
  down)
    compose down "${@:2}"
    ;;
  restart)
    # Only a container that exists can be restarted: after ./jukecord down there is none, and compose would say nothing.
    if [ -z "$(compose ps -a -q "$service" 2>/dev/null)" ]; then
      say "jukecord is not running here (./jukecord up)"
      exit 1
    fi
    compose restart "$service"
    wait_ready
    ;;
  open)
    # The container makes the link from the public address when there is one. Without it the container knows only its
    # own port (8795), not the one published here (JUKECORD_PORT), so the link is rebuilt on this machine's address.
    url=$(inside link | tail -n 1)
    if [ -z "$(setting JUKECORD_PUBLIC_URL)" ]; then
      url="$(panel_url)/auth/link/${url##*/}"
    fi
    open_url "$url"
    ;;
  status)
    if running; then
      compose ps "$service"
      inside status
    else
      say "jukecord is not running (./jukecord up)"
      exit 1
    fi
    ;;
  logs)
    if [ "${2:-}" = "-f" ] || [ "${2:-}" = "--follow" ]; then
      compose logs -f --tail 100 "$service"
    else
      inside logs "${@:2}"
    fi
    ;;
  doctor)
    # Each line says what was checked; a failure shows the tool's own words, and doctor ends with 1 when any failed.
    failed=0
    if ! command -v docker >/dev/null 2>&1; then
      printf 'docker: missing (https://docs.docker.com/get-docker/)\n'
      failed=1
    elif out=$(docker info --format '{{.ServerVersion}} ({{.OSType}}/{{.Architecture}})' 2>/dev/null); then
      printf 'docker: %s\n' "$out"
    else
      # Asked again for its error alone.
      printf 'docker: not answering: %s\n' "$(docker info --format '{{.ServerVersion}}' 2>&1 >/dev/null | tr '\n' ' ')"
      failed=1
    fi
    if command -v docker >/dev/null 2>&1 && out=$(docker compose version --short 2>&1); then
      printf 'compose: %s\n' "$out"
      # The settings as Compose reads them: a line it cannot read stops every other command.
      if out=$(docker compose config -q 2>&1); then
        printf 'settings: %s\n' "$([ -f .env ] && echo ".env ($(stat -c %a .env 2>/dev/null || stat -f %Lp .env 2>/dev/null || echo '?'))" || echo 'no .env (defaults)')"
      else
        printf 'settings: Compose cannot read them: %s\n' "$out"
        failed=1
      fi
    else
      printf 'compose: missing (https://docs.docker.com/compose/install/)\n'
      failed=1
    fi
    if [ "$failed" = 0 ] && running; then
      # The checks inside the container; their own failures count too.
      inside doctor || failed=1
    elif [ "$failed" = 0 ]; then
      say "jukecord is not running, so only this machine was checked (./jukecord up)"
      failed=1
    fi
    exit "$failed"
    ;;
  update)
    if built_here "$(image_name)"; then compose build --pull; else compose pull; fi
    compose up -d
    wait_ready
    inside status
    ;;
  backup)
    # Written inside the volume by jukecord itself (a consistent copy while it runs), then copied out here.
    file=$(inside backup --json | sed -n 's/.*"file": *"\([^"]*\)".*/\1/p')
    mkdir -p backups
    compose cp "$service:$file" "backups/$(basename "$file")"
    # The whole path: restore takes a relative one from where it is typed, which need not be this folder.
    printf '%s/backups/%s\n' "$here" "$(basename "$file")"
    ;;
  restore)
    file=${2:-}
    # A relative name is taken from where the command was typed, as any other program would.
    case "$file" in '' | /*) ;; *) file="$caller/$file" ;; esac
    if [ -z "$file" ]; then
      say "restore needs a backup file: ./jukecord restore backups/jukecord-<time>.db"
      exit 2
    fi
    if [ ! -f "$file" ]; then
      say "$file is not there; nothing was changed"
      exit 2
    fi
    # Checked before anything is stopped: an SQLite database starts with these 15 bytes (tr drops any NUL byte, which
    # the shell would warn about).
    if [ "$(head -c 15 "$file" | LC_ALL=C tr -d '\000')" != "SQLite format 3" ]; then
      say "$file is not a jukecord backup (not an SQLite database); nothing was changed"
      exit 2
    fi
    # Read whole, before anything is stopped, by the SQLite in the image (Node's), in a container of its own: a backup
    # cut short has the right first bytes, and swapped in it would leave jukecord unable to start. The copy it reads
    # goes into the data volume beside the database, where the restore needs the room anyway (the container's /tmp is
    # a small tmpfs, which a backup of 300 MB did not fit), under a name of its own, streamed rather than held in
    # memory, and removed whatever the verdict. The verdict is one line, marked "restore-check:" when it is about the
    # backup and "restore-copy:" when the copy could not be made (a full volume), which is what is shown.
    check='import fs from "node:fs";
import path from "node:path";
import { DatabaseSync } from "node:sqlite";
import { pipeline } from "node:stream/promises";
const copy = path.join(process.argv[1], "jukecord.db.restore-check");
let verdict;
let copied = false;
try {
  await pipeline(process.stdin, fs.createWriteStream(copy, { mode: 0o600 }));
  copied = true;
  const db = new DatabaseSync(copy, { readOnly: true });
  try {
    verdict = db.prepare("PRAGMA quick_check").get().quick_check;
    const tracks = db.prepare("SELECT 1 FROM sqlite_master WHERE type = ? AND name = ?").get("table", "tracks");
    if (verdict === "ok" && !tracks) verdict = "it has no jukecord tables";
  } finally {
    db.close();
  }
} catch (error) {
  verdict = error.message;
} finally {
  for (const part of ["", "-wal", "-shm", "-journal"]) fs.rmSync(copy + part, { force: true });
}
if (verdict !== "ok") {
  console.error((copied ? "restore-check: " : "restore-copy: ") + verdict);
  process.exitCode = 2;
}'
    if ! problem=$(compose run --rm --no-deps -T --entrypoint node "$service" --disable-warning=ExperimentalWarning --input-type=module -e "$check" /data <"$file" 2>&1); then
      # The check's own line when it said one; else the first line of an error (Docker's, or Node's), else the last.
      reason=$(printf '%s\n' "$problem" | sed -n 's/^restore-check: //p' | head -n 1)
      if [ -n "$reason" ]; then
        say "$file is not a whole jukecord backup ($reason); nothing was changed"
        exit 2
      fi
      reason=$(printf '%s\n' "$problem" | sed -n 's/^restore-copy: //p' | head -n 1)
      [ -n "$reason" ] || reason=$(printf '%s\n' "$problem" | sed -n '/Error/{p;q;}')
      [ -n "$reason" ] || reason=${problem##*$'\n'}
      say "$file could not be checked in the data volume ($reason); nothing was changed"
      exit 1
    fi
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    # However it ends, jukecord runs again afterwards: with the restored database, or the old one when a step failed.
    # (up, not start: after ./jukecord down there is no container to start.)
    trap start_again EXIT
    # Stopped first: the database must not change while it is replaced.
    compose stop "$service"
    # Done inside the volume as jukecord's own user, with the backup on stdin: a mounted file would keep this
    # machine's owner and mode (0600), which that user cannot read. Every step must work (set -e) or nothing changes.
    # The file is checked again as it arrived, before the current one is touched. The current one is folded into one
    # file (what its write-ahead log still holds included) and kept beside the new one, so a wrong file can be undone.
    # Single quotes on purpose: the script runs in the container, where its own variables expand.
    # shellcheck disable=SC2016
    swap='set -e
umask 077
cd /data
if ! cat > jukecord.db.restoring; then
  rm -f jukecord.db.restoring
  echo "jukecord: the backup could not be copied into the volume (is it full?); nothing was changed" >&2
  exit 1
fi
if [ "$(head -c 15 jukecord.db.restoring)" != "SQLite format 3" ]; then
  rm -f jukecord.db.restoring
  echo "jukecord: that file is not a jukecord backup (not an SQLite database); nothing was changed" >&2
  exit 2
fi
if [ -f jukecord.db ]; then
  node -e "const { DatabaseSync } = require(\"node:sqlite\"); const db = new DatabaseSync(\"jukecord.db\"); db.exec(\"PRAGMA wal_checkpoint(TRUNCATE)\"); db.close()" 2>/dev/null || true
fi
for part in jukecord.db jukecord.db-wal jukecord.db-shm; do
  if [ -f "$part" ]; then mv "$part" "$part.before-restore-$STAMP"; fi
done
mv jukecord.db.restoring jukecord.db'
    compose run --rm --no-deps -T -e "STAMP=$stamp" --entrypoint sh "$service" -c "$swap" <"$file"
    printf 'restored %s (the database before it: jukecord.db.before-restore-%s in the volume)\n' "$file" "$stamp"
    ;;
  version)
    inside status
    ;;
  help | -h | --help)
    # Help with a command of the jukecord command's own (./jukecord help add): that command's help, from the command
    # that runs it, when it is running to ask (the whole list was printed instead). The front door's own words, and
    # anything while it is not running, get the list below.
    case "${2:-}" in
      '' | up | down | restart | open | status | logs | doctor | update | backup | restore | version | help) ;;
      *)
        if docker compose version >/dev/null 2>&1 && running; then
          inside help "$2"
          exit
        fi
        ;;
    esac
    # The comment block at the top of this file, by its full path: the directory changed above, so a relative $0
    # would point nowhere.
    awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$here/${BASH_SOURCE[0]##*/}"
    # The jukecord command's own list, when it is running to ask (and without stopping here when Docker is missing).
    if docker compose version >/dev/null 2>&1 && running; then
      printf '\n'
      inside --help
    fi
    ;;
  *)
    # Running, the jukecord command inside judges every word itself (the image can be newer than this checkout, and
    # know commands the checkout does not). Not running, a word that is not one of its commands in the checkout beside
    # this file is a typing mistake, said as one rather than as "not running". Options (--json ...) and a checkout
    # without the source go to the command as they are.
    if ! running && [ -f "$here/src/cli/commands.ts" ] && [ "${1#-}" = "$1" ] &&
      ! sed -n "s/.*name: '\([a-z]*\).*/\1/p" "$here/src/cli/commands.ts" | grep -qx -- "$1"; then
      say "there is no command \"$1\" (./jukecord help)"
      exit 2
    fi
    inside "$@"
    ;;
esac
